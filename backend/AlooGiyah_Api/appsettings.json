{
  "Commerce": {
    "FarmApprovalHours": 12,
    "WholesaleRoles": [
      "Buyer",
      "Farmer",
      "Admin",
      "Manager"
    ]
  },
  "Marketplace": {
    "Mode": "Listings"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "AloGiyah_API",
    "Audience": "AloGiyahUsers",
    "ExpireMinutes": 120
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Auth": {
    "PhoneOtpEnabled": false,
    "ExposeOtpCodeInDevelopment": false
  },
  "Hosting": {
    "UseHttpsRedirection": true
  },
  "TrafficLimits": {
    "AccountPerMinute": 300,
    "IpPerMinute": 1200,
    "chat-send": 30,
    "chat-file": 5,
    "chat-room": 5,
    "chat-connect": 20,
    "WritesPerMinute": 60
  }
}
