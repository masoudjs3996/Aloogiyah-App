{
  "name": "frontend-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:android": "expo export --platform android --output-dir dist/android",
    "build:ios": "expo export --platform ios --output-dir dist/ios",
    "build:apk": "npx eas-cli@latest build --platform android --profile apk",
    "build:ipa": "npx eas-cli@latest build --platform ios --profile production",
    "dev:android": "expo run:android",
    "dev:ios": "expo run:ios",
    "format": "prettier --write src App.tsx index.ts *.json",
    "build:web": "expo export --platform web --output-dir dist/web",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@tanstack/react-query": "^5.104.1",
    "axios": "^1.20.0",
    "expo": "~55.0.32",
    "expo-build-properties": "~55.0.18",
    "expo-clipboard": "~55.0.17",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.41",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-image-manipulator": "~55.0.21",
    "expo-image-picker": "~55.0.24",
    "expo-linking": "~55.0.17",
    "expo-location": "~55.1.15",
    "expo-media-library": "~55.0.21",
    "expo-notifications": "~55.0.27",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-video": "~55.0.21",
    "expo-web-browser": "~55.0.20",
    "jalaali-js": "^2.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~55.0.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-render-html"
        ]
      }
    }
  }
}
